+/* Token reuse management. Experimental packed index, ordered by expiry/hash. */
+#define PICOQUIC_TOKEN_PAGE_SIZE 32
+struct st_picoquic_token_page_t {
+    uint64_t time[PICOQUIC_TOKEN_PAGE_SIZE];
+    uint64_t hash[PICOQUIC_TOKEN_PAGE_SIZE];
+    picoquic_registered_token_t* token[PICOQUIC_TOKEN_PAGE_SIZE];
+    size_t count;
+};
+struct st_picoquic_token_directory_t {
+    uint64_t time;
+    uint64_t hash;
+    picoquic_token_page_t* page;
+};
+
+static int picoquic_token_key_compare(uint64_t at, uint64_t ah, uint64_t bt, uint64_t bh)
+{
+    if (at != bt) return at < bt ? -1 : 1;
+    return ah == bh ? 0 : (ah < bh ? -1 : 1);
+}
+
+static size_t picoquic_token_page_find(picoquic_token_index_t* index, uint64_t time, uint64_t hash)
+{
+    size_t lo = 0, hi = index->page_count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (picoquic_token_key_compare(index->directory[mid].time, index->directory[mid].hash, time, hash) < 0) lo = mid + 1;
+        else hi = mid;
+    }
+    return lo == index->page_count && lo != 0 ? lo - 1 : lo;
+}
+
+static size_t picoquic_token_leaf_find(picoquic_token_page_t* page, uint64_t time, uint64_t hash)
+{
+    size_t lo = 0, hi = page->count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (picoquic_token_key_compare(page->time[mid], page->hash[mid], time, hash) < 0) lo = mid + 1;
+        else hi = mid;
+    }
+    return lo;
+}
+
+static void picoquic_token_page_refresh(picoquic_token_index_t* index, size_t page_id)
+{
+    picoquic_token_page_t* page = index->directory[page_id].page;
+    index->directory[page_id].time = page->time[page->count - 1];
+    index->directory[page_id].hash = page->hash[page->count - 1];
+}
+
+static int picoquic_token_directory_reserve(picoquic_token_index_t* index, size_t required)
+{
+    if (required > index->page_capacity) {
+        size_t capacity = index->page_capacity == 0 ? 8 : index->page_capacity;
+        picoquic_token_directory_t* directory;
+        while (capacity < required) {
+            if (capacity > SIZE_MAX / 2) return -1;
+            capacity *= 2;
+        }
+        if (capacity > SIZE_MAX / sizeof(*directory)) return -1;
+        directory = (picoquic_token_directory_t*)realloc(index->directory, capacity * sizeof(*directory));
+        if (directory == NULL) return -1;
+        index->directory = directory;
+        index->page_capacity = capacity;
+    }
+    return 0;
+}
+
+static picoquic_registered_token_t* picoquic_token_index_find(picoquic_token_index_t* index, uint64_t time, uint64_t hash)
+{
+    picoquic_token_page_t* page;
+    size_t at;
+    if (index->page_count == 0) return NULL;
+    page = index->directory[picoquic_token_page_find(index, time, hash)].page;
+    at = picoquic_token_leaf_find(page, time, hash);
+    return at < page->count && page->time[at] == time && page->hash[at] == hash ? page->token[at] : NULL;
+}
+
+static int picoquic_token_index_insert(picoquic_token_index_t* index, picoquic_registered_token_t* token)
+{
+    size_t page_id = picoquic_token_page_find(index, token->token_time, token->token_hash);
+    picoquic_token_page_t* page = index->page_count == 0 ? NULL : index->directory[page_id].page;
+    size_t at;
+    if (page == NULL || page->count == PICOQUIC_TOKEN_PAGE_SIZE) {
+        picoquic_token_page_t* fresh = (picoquic_token_page_t*)calloc(1, sizeof(*fresh));
+        if (fresh == NULL) return -1;
+        /* Acquire every allocation before mutating any indexed key. */
+        if (picoquic_token_directory_reserve(index, index->page_count + 1) != 0) {
+            free(fresh);
+            return -1;
+        }
+        if (page == NULL) {
+            page = fresh;
+            index->directory[0].page = page;
+            index->page_count = 1;
+        }
+        else {
+            size_t half = PICOQUIC_TOKEN_PAGE_SIZE / 2;
+            memcpy(fresh->time, page->time + half, half * sizeof(*page->time));
+            memcpy(fresh->hash, page->hash + half, half * sizeof(*page->hash));
+            memcpy(fresh->token, page->token + half, half * sizeof(*page->token));
+            fresh->count = half;
+            page->count = half;
+            memmove(index->directory + page_id + 2, index->directory + page_id + 1,
+                (index->page_count - page_id - 1) * sizeof(*index->directory));
+            index->directory[page_id + 1].page = fresh;
+            index->page_count++;
+            picoquic_token_page_refresh(index, page_id);
+            picoquic_token_page_refresh(index, page_id + 1);
+            if (picoquic_token_key_compare(token->token_time, token->token_hash, fresh->time[0], fresh->hash[0]) >= 0) {
+                page_id++;
+                page = fresh;
+            }
+        }
+    }
+    at = picoquic_token_leaf_find(page, token->token_time, token->token_hash);
+    memmove(page->time + at + 1, page->time + at, (page->count - at) * sizeof(*page->time));
+    memmove(page->hash + at + 1, page->hash + at, (page->count - at) * sizeof(*page->hash));
+    memmove(page->token + at + 1, page->token + at, (page->count - at) * sizeof(*page->token));
+    page->time[at] = token->token_time;
+    page->hash[at] = token->token_hash;
+    page->token[at] = token;
+    page->count++;
+    index->size++;
+    picoquic_token_page_refresh(index, page_id);
+    return 0;
+}
+
+static void picoquic_token_index_free(picoquic_token_index_t* index)
+{
+    for (size_t i = 0; i < index->page_count; i++) {
+        picoquic_token_page_t* page = index->directory[i].page;
+        for (size_t j = 0; j < page->count; j++) free(page->token[j]);
+        free(page);
+    }
+    free(index->directory);
+    memset(index, 0, sizeof(*index));
+}
