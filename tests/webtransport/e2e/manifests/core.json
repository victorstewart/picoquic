{
  "suite": "core",
  "description": "Portable WebTransport browser E2E scenarios backed by pico_baton.",
  "scenarios": [
    {
      "id": "handshake.reject_404",
      "title": "Unrouted WebTransport path rejects ready",
      "runner": "browser-baton",
      "wtUrl": "https://127.0.0.1:{port}/missing?version=0&baton=251&count=1&padding=0",
      "protocol": "devious-baton-00",
      "requireDatagram": true,
      "useByob": false,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready-rejects",
        "routing-reject",
        "server-no-connect-accept"
      ],
      "expect": {
        "ok": false,
        "url": "https://127.0.0.1:{port}/missing?version=0&baton=251&count=1&padding=0",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": false,
        "errorIncludes": "WebTransportError",
        "server": {
          "connectAccepted": 0,
          "packetsReceivedMin": 1,
          "packetsSentMin": 1
        }
      }
    },
    {
      "id": "handshake.reject_unsupported_protocol",
      "title": "Unsupported WT-Available-Protocols value rejects ready",
      "runner": "browser-baton",
      "wtUrl": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1&padding=0",
      "protocol": "unsupported-baton-00",
      "requireDatagram": true,
      "useByob": false,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready-rejects",
        "WT-Available-Protocols",
        "WT-Protocol-required",
        "server-no-connect-accept"
      ],
      "expect": {
        "ok": false,
        "url": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1&padding=0",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": false,
        "errorIncludes": "WebTransportError",
        "server": {
          "connectAccepted": 0,
          "packetsReceivedMin": 1,
          "packetsSentMin": 1
        }
      }
    },
    {
      "id": "handshake.reject_bad_baton_query",
      "title": "Malformed baton endpoint parameters reject ready",
      "runner": "browser-baton",
      "wtUrl": "https://127.0.0.1:{port}/baton?version=1&baton=251&count=1&padding=0",
      "protocol": "devious-baton-00",
      "requireDatagram": true,
      "useByob": false,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready-rejects",
        "endpoint-parameter-validation",
        "server-no-connect-accept"
      ],
      "expect": {
        "ok": false,
        "url": "https://127.0.0.1:{port}/baton?version=1&baton=251&count=1&padding=0",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": false,
        "errorIncludes": "WebTransportError",
        "server": {
          "connectAccepted": 0,
          "packetsReceivedMin": 1,
          "packetsSentMin": 1
        }
      }
    },
    {
      "id": "baton.core.padded-byob",
      "title": "Baton stream/datagram/protocol exchange with default padding and BYOB readers",
      "runner": "browser-baton",
      "wtUrl": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1",
      "protocol": "devious-baton-00",
      "requireDatagram": true,
      "useByob": true,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready",
        "closed",
        "WT-Protocol",
        "BYOB-reader",
        "default-padded-baton-packet",
        "incoming-unidirectional-stream",
        "incoming-bidirectional-stream",
        "outgoing-unidirectional-stream",
        "outgoing-bidirectional-stream",
        "datagram-send",
        "datagram-receive"
      ],
      "expect": {
        "ok": true,
        "url": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1",
        "protocol": "devious-baton-00",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": true,
        "received": [251, 253, 255],
        "sent": [252, 254, 0],
        "datagramsReceivedMin": 1,
        "datagramsSent": 1,
        "protocolConstructorOk": true,
        "server": {
          "connectAcceptedMin": 1,
          "packetsReceivedMin": 1,
          "packetsSentMin": 1
        }
      }
    },
    {
      "id": "baton.core.compact-default-reader",
      "title": "Baton stream/datagram/protocol exchange with compact packets",
      "runner": "browser-baton",
      "wtUrl": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1&padding=0",
      "protocol": "devious-baton-00",
      "requireDatagram": true,
      "useByob": false,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready",
        "closed",
        "WT-Protocol",
        "incoming-unidirectional-stream",
        "incoming-bidirectional-stream",
        "outgoing-unidirectional-stream",
        "outgoing-bidirectional-stream",
        "datagram-send",
        "datagram-receive"
      ],
      "expect": {
        "ok": true,
        "url": "https://127.0.0.1:{port}/baton?version=0&baton=251&count=1&padding=0",
        "protocol": "devious-baton-00",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": false,
        "received": [251, 253, 255],
        "sent": [252, 254, 0],
        "datagramsReceivedMin": 1,
        "datagramsSent": 1,
        "protocolConstructorOk": true,
        "server": {
          "connectAcceptedMin": 1,
          "packetsReceivedMin": 1,
          "packetsSentMin": 1
        }
      }
    }
  ]
}
