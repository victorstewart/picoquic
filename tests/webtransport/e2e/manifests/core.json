{
  "suite": "core",
  "description": "Portable WebTransport browser E2E scenarios backed by pico_baton.",
  "scenarios": [
    {
      "id": "baton.core.compact-default-reader",
      "title": "Baton stream/datagram/protocol exchange with compact packets",
      "runner": "browser-baton",
      "wtUrl": "https://localhost:{port}/baton?version=0&baton=251&count=1&padding=0",
      "protocol": "devious-baton-00",
      "requireDatagram": true,
      "useByob": false,
      "timeoutMs": 30000,
      "coverage": [
        "constructor",
        "ready",
        "closed",
        "WT-Protocol",
        "incoming-unidirectional-stream",
        "incoming-bidirectional-stream",
        "outgoing-unidirectional-stream",
        "outgoing-bidirectional-stream",
        "datagram-send",
        "datagram-receive"
      ],
      "expect": {
        "ok": true,
        "url": "https://localhost:{port}/baton?version=0&baton=251&count=1&padding=0",
        "protocol": "devious-baton-00",
        "requireDatagram": true,
        "constructorRequireUnreliable": true,
        "useByob": false,
        "received": [251, 253, 255],
        "sent": [252, 254, 0],
        "datagramsReceivedMin": 1,
        "datagramsSent": 1,
        "protocolConstructorOk": true
      }
    }
  ]
}
